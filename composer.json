{
    "name": "smmm/beyanname-takip",
    "description": "Mukellef Beyanname ve Evrak Takip Programi (CodeIgniter 4)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "exclude-from-classmap": ["**/Database/Migrations/**"]
    },
    "config": {
        "allow-plugins": { "*": true },
        "sort-packages": true
    }
}
